  "scripts": {
    "start": "npm run build:watch",
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --noCheck --watch --preserveWatchOutput",
    "build:types": "tsc -p tsconfig.json --noCheck --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1",
    "debug": ""
  },
